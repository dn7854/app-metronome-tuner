{
  "expo": {
    "name": "D8R Metronome&Tuner",
    "slug": "d8r-metronomeandtuner",
    "owner": "danijelbrecelj",
    "scheme": "d8rmetronome",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon larger.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#100e0c",
    "splash": {
      "image": "./assets/splash icon larger.png",
      "resizeMode": "contain",
      "backgroundColor": "#100e0c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danijelbrecelj.chordstuner",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "D8R Metronome&Tuner listens while you tune. The audio stays on this device.",
        "UIBackgroundModes": [
          "audio",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.danijelbrecelj.chordstuner",
      "versionCode": 13,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon larger.png",
        "backgroundColor": "#100e0c"
      },
      "permissions": [
        "RECORD_AUDIO",
        "VIBRATE",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "iosMicrophonePermission": "D8R Metronome&Tuner listens while you tune. The audio stays on this device.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.VIBRATE"
          ],
          "androidForegroundService": false,
          "androidFSTypes": [
            "mediaPlayback"
          ],
          "disableFFmpeg": true
        }
      ],
      "./plugins/withAndroidReleaseFixes"
    ],
    "extra": {
      "eas": {
        "projectId": "55ee69f0-dc61-4e1d-a7bf-8657afde68f9"
      }
    }
  }
}
